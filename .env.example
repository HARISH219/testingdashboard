# ===========================================================================
# Snowy dashboard — environment variables
#
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env          (macOS/Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# `.env` is gitignored and must NEVER be committed.
# The app runs in DEMO MODE (mock auth + sample data) until the Discord and
# auth secrets below are provided, so you can review the UI with zero setup.
# ===========================================================================


# ---------------------------------------------------------------------------
# 1. APP / AUTH
# ---------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
# Required to leave demo mode. Generate with:
#   openssl rand -base64 32
#   (PowerShell) [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
NEXTAUTH_SECRET=


# ---------------------------------------------------------------------------
# 2. DISCORD BOT CREDENTIALS
# From https://discord.com/developers/applications
#
# OAuth2 -> Redirects, add:
#   http://localhost:3000/api/auth/callback/discord
# Bot -> Privileged Gateway Intents: enable SERVER MEMBERS and MESSAGE CONTENT
# ---------------------------------------------------------------------------
# Application ID (also used to build the bot invite link)
DISCORD_CLIENT_ID=
# OAuth2 -> Client Secret. NEVER expose this to the browser.
DISCORD_CLIENT_SECRET=
# Bot -> Token. Used to check bot presence and fetch channels/roles.
DISCORD_BOT_TOKEN=
# Optional: public key for interaction signature verification
DISCORD_PUBLIC_KEY=


# ---------------------------------------------------------------------------
# 3. OWNER & ADMIN IDS
# Comma or space separated Discord user IDs (17-19 digit snowflakes).
# Enable Discord Developer Mode, right-click your name -> Copy User ID.
# ---------------------------------------------------------------------------
# Bot owner(s) — highest level of access across every guild
BOT_OWNER_IDS=
# Extra trusted owners — owner-level dashboard access (co-owners, partners)
EXTRA_OWNER_IDS=
# Snowy platform administrators — access to the /admin panel
ADMIN_DISCORD_IDS=
# Example:
# BOT_OWNER_IDS=123456789012345678
# EXTRA_OWNER_IDS=234567890123456789,345678901234567890
# ADMIN_DISCORD_IDS=123456789012345678


# ---------------------------------------------------------------------------
# 4. DATABASE (PostgreSQL via Prisma)
# After setting this run: npm run db:push && npm run db:seed
# ---------------------------------------------------------------------------
DATABASE_URL=
# Example: postgresql://postgres:password@localhost:5432/snowy?schema=public


# ---------------------------------------------------------------------------
# 5. SNOWY BOT INTERNAL API (your discord.js service)
# When set, the dashboard performs real bot actions instead of "pending".
# ---------------------------------------------------------------------------
BOT_API_URL=
# Shared secret the dashboard sends as: Authorization: Bearer <secret>
BOT_API_SECRET=
# Example: BOT_API_URL=http://localhost:4000


# ---------------------------------------------------------------------------
# 6. LAVALINK (music)
# Used by the Lavalink diagnostics page.
# ---------------------------------------------------------------------------
LAVALINK_HOST=
LAVALINK_PORT=
LAVALINK_PASSWORD=
LAVALINK_SECURE=false
# Example:
# LAVALINK_HOST=localhost
# LAVALINK_PORT=2333
# LAVALINK_PASSWORD=youshallnotpass


# ---------------------------------------------------------------------------
# 7. STRIPE (subscriptions)
# Local webhooks:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# 7b. RAZORPAY (subscriptions, alternative to Stripe)
# Get keys from https://dashboard.razorpay.com/app/keys
#   Key ID is public (used by the checkout widget on the frontend).
#   Key Secret is private (used server-side to create orders + verify payments).
# Both must be set for Razorpay checkout to activate.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------------------------------------------------------------------------
# 8. Branding (optional)
# ---------------------------------------------------------------------------
# Bot avatar shown as the top-left logo (public URL or a /public path).
# Leave blank to use the built-in snowflake mark.
NEXT_PUBLIC_BRAND_LOGO_URL=
# Optional banner image. Leave blank to hide the banner entirely.
NEXT_PUBLIC_BRAND_BANNER_URL=
